<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <!-- Cualquier aviso nuevo del compilador o de los analizadores rompe la compilación: se corrige, no se acumula. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Product>Claude Multi-Account</Product>
    <Description>Abre el Claude Desktop oficial una vez por cuenta, cada una con sus propios datos. No es una herramienta oficial de Anthropic.</Description>
  </PropertyGroup>
</Project>
