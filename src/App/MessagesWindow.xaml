<Window x:Class="ClaudeMultiAccount.App.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ClaudeMultiAccount.App.Controls"
        Title="Mensajes entre cuentas"
        Width="720" Height="720" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Language="es-ES" FontSize="14">
    <!-- Interruptor arriba, cómo se usa en medio y el historial debajo. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Content="Cerrar" IsCancel="True" IsDefault="True" MinWidth="110" Style="{StaticResource SecondaryButton}" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,22">
                <TextBlock Text="Mensajes entre cuentas" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" LineHeight="21"
                           Text="Pide a un Claude que le pase algo a otra de tus cuentas desde un chat de Code. Los mensajes se quedan en tu PC: no pasan por internet." />

                <c:SettingsCard Icon="&#xE8BD;" Header="Mensajes entre cuentas" Description="{Binding StateText}" Margin="0,18,0,0">
                    <Grid>
                        <Button Command="{Binding ToggleCommand}" Content="Activar" MinWidth="110" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Activar los mensajes entre cuentas" />
                        <Button Command="{Binding ToggleCommand}" Content="Desactivar" MinWidth="110" Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="Desactivar los mensajes entre cuentas" />
                    </Grid>
                </c:SettingsCard>

                <ItemsControl ItemsSource="{Binding Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:Notice Severity="Warning" Message="{Binding}" Margin="0,8,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Cómo se usa" Style="{StaticResource GroupHeader}" />
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1" Style="{StaticResource GroupHeader}" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="En un chat de Code de una cuenta, pídeselo con tus palabras" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Por ejemplo: «dile a Claude Pro que el error está en login.js y pásale un resumen de lo que hicimos»." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="2" Style="{StaticResource GroupHeader}" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Se abre un chat de Code nuevo en la otra cuenta, con el mensaje escrito" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="En la misma carpeta y sin enviar: lo envías tú cuando quieras. Te aviso con una notificación. Claude Multi-Account tiene que estar abierto (en la bandeja); si no, el mensaje llega cuando escribas en esa cuenta." />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="3" Style="{StaticResource GroupHeader}" Margin="0,0,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="En ese chat puedes seguir hablando y pedirle que conteste" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="Por ejemplo: «respóndele a Claude Max que…». La respuesta llega al chat de Max donde empezó todo, cuando le escribas." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <c:Notice Severity="Informational" Margin="0,8,0,0"
                          Message="Sirve para pasar información, no para que una cuenta ponga a trabajar a otra sin ti: repartir el uso entre cuentas va contra los términos de Anthropic. Nunca se envían contraseñas ni claves (se rechazan)." />

                <TextBlock Text="Historial" Style="{StaticResource GroupHeader}" />
                <Border Style="{StaticResource Card}" Padding="24,20"
                        Visibility="{Binding HasNoMessages, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="28" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Todavía no hay mensajes." Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Messages}" AutomationProperties.Name="Historial de mensajes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Direction}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                                    Visibility="{Binding Unread, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Sin entregar" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding When}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20" MaxHeight="160"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
