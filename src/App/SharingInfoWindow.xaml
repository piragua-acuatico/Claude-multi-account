<Window x:Class="ClaudeMultiAccount.App.SharingInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qué comparte cada perfil"
        Width="720" Height="720" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Language="es-ES" FontSize="14">
    <Window.Resources>
        <!-- Tarjeta con filas separadas por una línea fina; la primera fila no lleva línea. -->
        <DataTemplate x:Key="ItemTemplate">
            <Border x:Name="Row" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="11" Margin="0,1,6,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding EvidenceLabel}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Cabecera de grupo con una insignia de color (verde: separado; ámbar: compartido). -->
        <Style x:Key="GroupBadge" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Content="Cerrar" IsCancel="True" IsDefault="True" MinWidth="110" HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,22">
                <TextBlock Text="Qué comparte cada perfil" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" LineHeight="21"
                           Text="Cada perfil ejecuta el mismo Claude Desktop oficial con sus propias carpetas. Esto es lo que queda separado y lo que sigue siendo común." />

                <StackPanel Orientation="Horizontal" Margin="2,24,0,10">
                    <Border Style="{StaticResource GroupBadge}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    </Border>
                    <TextBlock Text="Separado en cada perfil" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="0">
                    <ItemsControl ItemsSource="{Binding Separate}" ItemTemplate="{StaticResource ItemTemplate}" AlternationCount="2147483647" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="2,24,0,10">
                    <Border Style="{StaticResource GroupBadge}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </Border>
                    <TextBlock Text="Compartido entre todos los perfiles" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="0">
                    <ItemsControl ItemsSource="{Binding Shared}" ItemTemplate="{StaticResource ItemTemplate}" AlternationCount="2147483647" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="2,24,0,10">
                    <Border Style="{StaticResource GroupBadge}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Dónde guarda sus datos cada perfil" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ProfileFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Claude Desktop" Style="{StaticResource Caption}" Margin="0,1,16,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DesktopDataDir}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Grid.Row="1" Text="Claude Code" Style="{StaticResource Caption}" Margin="0,5,16,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClaudeConfigDir}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Caption}" Margin="2,6,0,0"
                           Text="Claude Desktop instalado desde la Tienda guarda en realidad las carpetas nuevas de %APPDATA% dentro de su paquete (LocalCache); Windows las muestra en las dos rutas." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
