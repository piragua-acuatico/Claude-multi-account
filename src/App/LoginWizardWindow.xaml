<Window x:Class="ClaudeMultiAccount.App.LoginWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeMultiAccount.App.ViewModels"
        xmlns:c="clr-namespace:ClaudeMultiAccount.App.Controls"
        Title="{Binding Title}"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Topmost="False"
        Language="es-ES" FontSize="14">
    <Window.Resources>
        <Style x:Key="StepPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="LineHeight" Value="21" />
        </Style>

        <!-- Punto del indicador de pasos. Tag = «Done» (marca), «Current» (número con acento) o «Pending» (contorno). -->
        <Style x:Key="StepDot" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid Width="28" Height="28">
                            <Ellipse x:Name="Back" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5" />
                            <TextBlock x:Name="Number" Text="{TemplateBinding Content}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="12"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Current">
                                <Setter TargetName="Back" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="Stroke" Value="{x:Null}" />
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Done">
                                <Setter TargetName="Back" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="Stroke" Value="{x:Null}" />
                                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <Button Content="Cancelar" IsCancel="True" HorizontalAlignment="Left" MinWidth="110" Style="{StaticResource SecondaryButton}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Atrás" Command="{Binding BackCommand}" MinWidth="110" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" />
                    <Button Content="{Binding NextLabel}" Command="{Binding NextCommand}" IsDefault="True" MinWidth="110" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="24,24,24,22">
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding StepText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />

            <!-- Indicador de pasos -->
            <Grid Margin="0,20,0,22" AutomationProperties.Name="{Binding StepText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Width="120">
                    <ContentControl Style="{StaticResource StepDot}" Content="1" Tag="{Binding Step1State}" />
                    <TextBlock Text="Cerrar los demás" Style="{StaticResource StepLabel}" />
                </StackPanel>
                <Rectangle Grid.Column="1" Height="1.5" VerticalAlignment="Top" Margin="-44,13,-44,0" Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                <StackPanel Grid.Column="2" Width="120">
                    <ContentControl Style="{StaticResource StepDot}" Content="2" Tag="{Binding Step2State}" />
                    <TextBlock Text="Iniciar sesión" Style="{StaticResource StepLabel}" />
                </StackPanel>
                <Rectangle Grid.Column="3" Height="1.5" VerticalAlignment="Top" Margin="-44,13,-44,0" Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                <StackPanel Grid.Column="4" Width="120">
                    <ContentControl Style="{StaticResource StepDot}" Content="3" Tag="{Binding Step3State}" />
                    <TextBlock Text="Comprobar la cuenta" Style="{StaticResource StepLabel}" />
                </StackPanel>
            </Grid>

            <!-- Paso 1: cerrar los demás Claude -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:LoginWizardStep.CloseOthers}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Cierra los demás Claude" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Al iniciar sesión, Windows devuelve el resultado a Claude. Si hay otro Claude abierto, podría llegarle a ese y la sesión quedaría en la cuenta equivocada. Por eso, mientras inicias sesión, solo debe estar abierto este perfil." />
                <c:Notice Severity="Warning" Title="Todavía están abiertos" Margin="0,14,0,0">
                    <c:Notice.Style>
                        <Style TargetType="c:Notice" BasedOn="{StaticResource {x:Type c:Notice}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllOthersClosed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:Notice.Style>
                    <StackPanel Margin="0,-6,0,0">
                        <ItemsControl ItemsSource="{Binding OpenOthers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Cerrar los abiertos desde la herramienta…" Command="{Binding CloseOthersCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </c:Notice>
                <c:Notice Severity="Success" Title="No hay otros Claude abiertos" Message="Ya puedes seguir." Margin="0,14,0,0"
                          Visibility="{Binding AllOthersClosed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Paso 2: iniciar sesión -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:LoginWizardStep.SignIn}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Abre el perfil e inicia sesión" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Pulsa el botón. En la ventana de Claude que se abre, pulsa iniciar sesión: se abrirá tu navegador." />
                <Button Command="{Binding OpenProfileCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Style="{StaticResource PrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ProfileName, StringFormat=Abrir «{0}»}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding LaunchMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <c:Notice Severity="Warning" Title="Antes de aceptar en el navegador"
                          Message="Mira qué correo aparece en la pantalla de autorización: debe ser el de la cuenta de este perfil. Si es otro, cambia de cuenta en el navegador antes de seguir."
                          Margin="0,14,0,0" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="Si aparece otra ventana de Claude que solo muestra un código, ciérrala; si la ventana de este perfil te pide un código, cópialo de ahí. La herramienta no ve tu contraseña ni tu sesión: todo pasa entre tu navegador y Claude." />
            </StackPanel>

            <!-- Paso 3: comprobar la cuenta -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource StepPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:LoginWizardStep.Verify}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Comprueba la cuenta" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Style="{StaticResource Hint}" Text="En la ventana de este perfil abre Ajustes y mira qué correo muestra." />
                <c:SettingsCard Icon="&#xE715;" Header="Correo que ves" Description="Opcional: solo para recordarte qué cuenta es." Margin="0,14,0,0">
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Width="240"
                             AutomationProperties.Name="Correo de la cuenta" />
                </c:SettingsCard>
                <c:Notice Severity="Error" Message="{Binding DuplicateWarning}" Margin="0,8,0,0">
                    <c:Notice.Style>
                        <Style TargetType="c:Notice" BasedOn="{StaticResource {x:Type c:Notice}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DuplicateWarning}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:Notice.Style>
                </c:Notice>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="¿Es la cuenta de este perfil?" />
                        <RadioButton Content="Sí, es la cuenta de este perfil" IsChecked="{Binding AccountIsCorrect}" Margin="0,10,0,0" GroupName="cuenta" />
                        <RadioButton Content="No, es otra cuenta" IsChecked="{Binding AccountIsWrong}" Margin="0,6,0,0" GroupName="cuenta" />
                    </StackPanel>
                </Border>
                <c:Notice Severity="Error" Title="Cambia de cuenta"
                          Message="En esa ventana cierra sesión desde el menú de tu cuenta, pulsa «Atrás» y vuelve a iniciar sesión con la cuenta correcta (cambia de cuenta en el navegador si hace falta)."
                          Margin="0,8,0,0" Visibility="{Binding AccountIsWrong, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <c:Notice Severity="Error" Message="{Binding Error}" Margin="0,14,0,0">
                <c:Notice.Style>
                    <Style TargetType="c:Notice" BasedOn="{StaticResource {x:Type c:Notice}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </c:Notice.Style>
            </c:Notice>
        </StackPanel>
    </DockPanel>
</Window>
