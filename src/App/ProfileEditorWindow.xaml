<Window x:Class="ClaudeMultiAccount.App.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ClaudeMultiAccount.App.Controls"
        Title="{Binding Title}"
        Width="640" SizeToContent="Height" MaxHeight="860" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Language="es-ES" FontSize="14">
    <!-- Como una página de Configuración de Windows 11: cabecera con la vista previa y una tarjeta por ajuste. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" MinWidth="110" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" />
                <Button Content="Guardar" IsDefault="True" MinWidth="110" Click="OnSave" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,22">
                <!-- Cabecera: así se verá el perfil -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56" Margin="0,0,16,0">
                        <Ellipse Fill="{Binding SelectedColor.Hex}" />
                        <TextBlock Text="{Binding PreviewInitial}" Foreground="White" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="Cada perfil es un Claude con su propia cuenta, sus chats de Code y sus ajustes." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Perfil" Style="{StaticResource GroupHeader}" />
                <c:SettingsCard Icon="&#xE77B;" Header="Nombre" Description="Cómo lo verás en la lista, en la bandeja y en sus accesos directos.">
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="250"
                             MaxLength="64" AutomationProperties.Name="Nombre" />
                </c:SettingsCard>
                <c:SettingsCard Icon="&#xE790;" Header="Color" Description="El color de su avatar y de su icono." Margin="0,4,0,0">
                    <ListBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}"
                             BorderThickness="0" Background="Transparent" AutomationProperties.Name="Color"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                <Setter Property="ToolTip" Value="{Binding Label}" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <!-- Muestra redonda; la elegida lleva un anillo del color del texto, como en Windows. -->
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid Width="32" Height="32" Margin="2,0" Background="Transparent">
                                                <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" Visibility="Hidden" />
                                                <Ellipse Width="22" Height="22" Fill="{Binding Hex}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </c:SettingsCard>
                <c:SettingsCard Icon="&#xE8D2;" Header="Inicial" Description="La letra del avatar. Vacía: la primera del nombre." Margin="0,4,0,0">
                    <TextBox Text="{Binding Initial, UpdateSourceTrigger=PropertyChanged}" Width="56" MaxLength="2"
                             HorizontalContentAlignment="Center" AutomationProperties.Name="Inicial" />
                </c:SettingsCard>
                <c:SettingsCard Icon="&#xE715;" Header="Correo de referencia" Description="Solo para recordarte qué cuenta es. La herramienta no lo comprueba ni lo envía." Margin="0,4,0,0">
                    <TextBox Text="{Binding EmailHint, UpdateSourceTrigger=PropertyChanged}" Width="250" MaxLength="200"
                             AutomationProperties.Name="Correo de referencia" />
                </c:SettingsCard>

                <TextBlock Text="Carpetas de trabajo" Style="{StaticResource GroupHeader}" />
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Las carpetas donde trabaja este perfil con Code. Si otro perfil abierto usa la misma, te avisaré antes de abrirlo para que no se pisen los cambios." />
                        <ListBox ItemsSource="{Binding WorkFolders}" SelectedItem="{Binding SelectedWorkFolder}" MinHeight="44" MaxHeight="140"
                                 Margin="0,10,0,0" AutomationProperties.Name="Carpetas de trabajo">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Command="{Binding AddFolderCommand}" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Añadir carpeta">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" FontSize="12" />
                                    <TextBlock Text="Añadir carpeta…" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveFolderCommand}" Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Quitar carpeta">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" FontSize="12" />
                                    <TextBlock Text="Quitar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding FolderNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:Notice Severity="Warning" Message="{Binding}" Margin="0,10,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding ShowsDataFolders, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Datos del perfil" Style="{StaticResource GroupHeader}" />
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="20" Margin="2,0,18,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Carpetas de Claude (automáticas)" />
                                <TextBlock Text="{Binding DataFoldersNote}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                                <TextBlock Text="{Binding DataDir}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ConfigDir}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <c:Notice Severity="Error" Message="{Binding Error}" Margin="0,16,0,0">
                    <c:Notice.Style>
                        <Style TargetType="c:Notice" BasedOn="{StaticResource {x:Type c:Notice}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:Notice.Style>
                </c:Notice>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
