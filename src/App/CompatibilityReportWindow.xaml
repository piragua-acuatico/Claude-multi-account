<Window x:Class="ClaudeMultiAccount.App.CompatibilityReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ClaudeMultiAccount.App.Controls"
        Title="Comprobación de compatibilidad"
        Width="620" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Language="es-ES" FontSize="14">
    <!-- Resultado arriba (verde o rojo) y debajo una tarjeta con cada comprobación. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Content="Cerrar" IsCancel="True" IsDefault="True" MinWidth="110" HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}" />
        </Border>

        <DockPanel Margin="24,24,24,22">
            <TextBlock DockPanel.Dock="Top" Text="Comprobación de compatibilidad" Style="{StaticResource SectionTitle}" />
            <c:Notice DockPanel.Dock="Top" Message="{Binding Summary}" Margin="0,14,0,0">
                <c:Notice.Style>
                    <Style TargetType="c:Notice" BasedOn="{StaticResource {x:Type c:Notice}}">
                        <Setter Property="Severity" Value="Error" />
                        <Setter Property="Title" Value="Hay algo que revisar" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllOk}" Value="True">
                                <Setter Property="Severity" Value="Success" />
                                <Setter Property="Title" Value="Todo en orden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </c:Notice.Style>
            </c:Notice>
            <TextBlock DockPanel.Dock="Top" Text="Detalles" Style="{StaticResource GroupHeader}" />

            <Border Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}" AlternationCount="2147483647">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Una fila por comprobación, separadas por una línea fina (salvo la primera). -->
                                <Border x:Name="Row" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="20" Height="20" Margin="0,1,14,0" VerticalAlignment="Top">
                                            <Ellipse x:Name="Badge" Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                        <Setter TargetName="Badge" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                        <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
